@model EasyUpdate.Data.Entities.ScheduledUpdate

<h2>Update Details</h2>

<dl class="row">
    <dt class="col-sm-3">Application</dt>
    <dd class="col-sm-9">@Model.SoftwareApp.Name</dd>

    <dt class="col-sm-3">Target Version</dt>
    <dd class="col-sm-9">@Model.TargetVersion</dd>

    <dt class="col-sm-3">Scheduled Start</dt>
    <dd class="col-sm-9">@Model.ScheduledStart.ToString("g")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Scheduled By</dt>
    <dd class="col-sm-9">@Model.ScheduledByUser?.UserName</dd>

    <dt class="col-sm-3">Executed At</dt>
    <dd class="col-sm-9">@(Model.ExecutedAt?.ToString("g") ?? "—")</dd>

    <dt class="col-sm-3">Completed At</dt>
    <dd class="col-sm-9">@(Model.CompletedAt?.ToString("g") ?? "—")</dd>

    @if (!string.IsNullOrEmpty(Model.FailureReason))
    {
        <dt class="col-sm-3">Failure Reason</dt>
        <dd class="col-sm-9 text-danger">@Model.FailureReason</dd>
    }

    @if (!string.IsNullOrEmpty(Model.LogOutput))
    {
        <dt class="col-sm-3">Log Output</dt>
        <dd class="col-sm-9"><pre>@Model.LogOutput</pre></dd>
    }
</dl>

<a asp-action="Index" class="btn btn-secondary">Back to List</a>