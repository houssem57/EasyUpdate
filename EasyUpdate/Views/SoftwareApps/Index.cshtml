@model IEnumerable<EasyUpdate.Data.Entities.SoftwareApp>

<h2>Software Applications</h2>
<a asp-action="Create" class="btn btn-primary mb-3">+ Register New App</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Current Version</th>
            <th>Server Path</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.Name</td>
                <td>@app.CurrentVersion</td>
                <td>@app.AppFolderPath</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@app.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@app.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>